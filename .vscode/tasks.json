{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 构建",
      "type": "shell",
      "command": "D:/Tool/CMake/cmake-4.4.3-windows-x86_64/bin/cmake.exe",
      "args": [
        "--build",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "cmake --build build（CMakeLists 变更会自动重新配置）"
    },
    {
      "label": "CMake: 首次配置",
      "type": "shell",
      "command": "D:/Tool/CMake/cmake-4.4.3-windows-x86_64/bin/cmake.exe",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-G",
        "MinGW Makefiles",
        "-DCMAKE_CXX_COMPILER=D:/Tool/VSCode/mingw64/bin/g++.exe",
        "-DCMAKE_MAKE_PROGRAM=D:/Tool/VSCode/mingw64/bin/mingw32-make.exe"
      ],
      "problemMatcher": [],
      "detail": "新机器或删除 build 目录后先跑一次"
    }
  ]
}
